{
  "name": "@guybendavid/utils",
  "version": "3.0.0",
  "author": "Guy Ben David",
  "license": "BSD-3-Clause",
  "type": "module",
  "description": "General utilities",
  "keywords": [
    "utils",
    "utilities"
  ],
  "bin": "./index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "imports": {
    "#root/*": "./*"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test --import tsx tests/**/*.test.*",
    "lint": "eslint . && npx strictify unimported-exports && knip && npm run --silent knip:validate-paths",
    "lint:eslint-fix": "eslint . --fix",
    "format": "prettier --write .",
    "validate": "npm run lint && npm run test && npx prettier --check .",
    "prepare": "husky",
    "knip:validate-paths": "node node_modules/strictify/scripts/validate-knip-paths.js"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "knip": "^5.70.1",
    "prettier": "^3.4.2",
    "pretty-quick": "^4.0.0",
    "strictify": "file:../strictify",
    "tsx": "^4.21.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guybendavid/utils.git"
  },
  "bugs": {
    "url": "https://github.com/guybendavid/utils/issues"
  },
  "homepage": "https://github.com/guybendavid/utils#readme"
}
