{
  "name": "@guybendavid/utils",
  "version": "3.0.0",
  "type": "module",
  "author": "Guy Ben David",
  "license": "BSD-3-Clause",
  "description": "General utilities",
  "keywords": [
    "utils",
    "utilities"
  ],
  "main": "index.js",
  "bin": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "find-unimported-exports": "node find-unimported-exports.js",
    "find-unimported-files": "knip",
    "build": "npm run lint && npm run find-unimported-exports && npm run find-unimported-files && npm run format",
    "prepare": "husky"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/parser": "^7.26.3",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-unicorn": "^56.0.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "glob": "^13.0.0",
    "husky": "^9.1.7",
    "knip": "^5.70.1",
    "prettier": "^3.4.2",
    "pretty-quick": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guybendavid/utils.git"
  },
  "bugs": {
    "url": "https://github.com/guybendavid/utils/issues"
  },
  "homepage": "https://github.com/guybendavid/utils#readme"
}
